# Copy to .env.local and edit. Never commit .env.local.
#
# Implausible needs no API keys. Every value below is local configuration.
# If a feature ever appears to require a third-party key, it is out of scope.

# Comma-separated list of domains allowed to send events.
# Requests for any other domain are rejected at ingest.
IMPLAUSIBLE_ALLOWED_DOMAINS=localhost,example.com

# Where the DuckDB file lives. Created on first run.
IMPLAUSIBLE_DB_PATH=./data/implausible.duckdb

# Where the rotating salt is persisted between restarts.
IMPLAUSIBLE_SALT_PATH=./data/salt.json

# Optional: path to a local MaxMind GeoLite2-Country.mmdb file.
# Omit it and country attribution is simply reported as unknown.
# Download requires a free MaxMind account; the file is read locally,
# no request ever leaves the server.
# IMPLAUSIBLE_GEOIP_PATH=./data/GeoLite2-Country.mmdb

# Max events accepted per hashed IP per minute.
IMPLAUSIBLE_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Only needed for docker-compose.yml. See DEPLOYING.md.
# ---------------------------------------------------------------------------

# The hostname this dashboard will be served from. Caddy obtains a certificate
# for it automatically.
ANALYTICS_HOST=analytics.example.com

# v0 has no login of its own, so the reverse proxy provides one. Generate the
# hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'pw'
# Quote it with SINGLE quotes — the hash contains $ and Compose would
# interpolate it out of a double-quoted value.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=
